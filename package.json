{
  "name": "mapa-mundi-estudio",
  "private": true,
  "version": "0.1.0",
  "description": "Mapamundi interactivo (globo 3D y mapa plano 2D) para aprender los países del mundo jugando.",
  "type": "module",
  "packageManager": "pnpm@8.11.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "atlas": "node scripts/build-atlas.mjs",
    "dev": "node scripts/build-atlas.mjs && vite",
    "build": "node scripts/build-atlas.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/besley": "^5.3.0",
    "earcut": "^3.2.4",
    "motion": "^14.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "d3-geo": "^3.1.2",
    "d3-geo-projection": "^4.0.0",
    "flag-icons": "^7.6.0",
    "moment-timezone": "^0.6.6",
    "polylabel": "^2.1.0",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
