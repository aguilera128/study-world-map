# Copia este fichero a .env.local y rellena lo que necesites. Todo es opcional en local:
# sin ningún valor, `pnpm dev` arranca igual y lo que depende de cada variable se apaga.
# En Vercel se definen en Settings → Environment Variables.
# .env.local no va al repositorio. No escribas valores reales aquí.

# ───────── Sitio (públicas: acaban en el HTML y en el JavaScript del navegador) ─────────

# Dirección pública del sitio, sin barra final. Se usa en canonical, hreflang, sitemap y robots.txt.
# Por defecto: http://localhost:5173
VITE_SITE_URL=

# Correo de contacto («informar de un error», aviso legal). Sin él no salen esos enlaces.
VITE_CONTACT_EMAIL=

# Enlace de donación (por ejemplo, https://paypal.me/tu-cuenta). Sin él no hay página ni botón de donar.
VITE_DONATE_URL=

# Contenedor de Google Tag Manager (GTM-XXXXXXX). Sin él no hay analítica ni aviso de cookies.
VITE_GTM_ID=

# Almacén público con las teselas de detalle de la imagen de satélite y de las luces nocturnas
# (scripts/download-tiles.mjs, convert-tiles.py y upload-tiles.mjs). Sin él se ve la imagen general.
# Si no es un Blob de Vercel, hay que añadir su dominio a «connect-src» en vercel.json.
VITE_TILE_STORE=

# ───────── Titular del sitio (aviso legal; solo los lee scripts/build-pages.mjs) ─────────
# Son obligatorios para desplegar en Vercel: sin ellos el build falla a propósito, para no publicar
# un aviso legal a medias. Los textos legales (scripts/data/legales.mjs) son los del sitio original:
# si despliegas el tuyo, revísalos.
TITULAR_NOMBRE=
TITULAR_NIF=
TITULAR_DOMICILIO=

# ───────── Servidor (secretas: nunca con el prefijo VITE_) ─────────

# PostgreSQL de Neon para la sincronización por código y los rankings (api/sync.ts, api/ranking.ts).
# Sin ella, esas dos funciones no responden y el resto de la web funciona igual.
# Las tablas se crean con `node scripts/db-init.mjs`, que usa la conexión directa (sin pooler).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Solo para subir teselas al Blob de Vercel con scripts/upload-tiles.mjs. Con OIDC (recomendado por
# Vercel), «vercel env pull» trae BLOB_STORE_ID y VERCEL_OIDC_TOKEN, que caduca en horas. Si no, la
# clave permanente BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=
